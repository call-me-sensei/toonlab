{
  "name": "@call-me-sensei/toonlab",
  "version": "0.3.1",
  "description": "Stylized (anime/toon) game starter kit for Three.js: character and environment shading, lighting, weather, water, vegetation, sky, and post-processing",
  "license": "MIT",
  "author": "Hyperbond Studio PTE. LTD. (Call Me Sensei)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/call-me-sensei/toonlab.git"
  },
  "homepage": "https://github.com/call-me-sensei/toonlab#readme",
  "bugs": {
    "url": "https://github.com/call-me-sensei/toonlab/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "toon",
    "cel-shading",
    "anime",
    "shader",
    "lighting",
    "water",
    "weather",
    "game-starter"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "toonlab-mcp": "./mcp/server.mjs"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "src",
    "mcp",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./toon": "./src/toon/index.js",
    "./environment": "./src/environment/index.js",
    "./water": "./src/water/index.js",
    "./vegetation": "./src/vegetation/index.js",
    "./vegetation-shaders": "./src/vegetation/vegetationShaders.js",
    "./grass-palettes": "./src/vegetation/grassPalettes.js",
    "./styles": "./src/styles/index.js",
    "./sky": "./src/sky/index.js",
    "./cloud": "./src/cloud/index.js",
    "./weather": "./src/weather/index.js",
    "./climate": "./src/climate/index.js",
    "./atmospheric-condition": "./src/atmospheric-condition/index.js",
    "./post": "./src/post/index.js",
    "./rock-shader": "./src/rock-shader/index.js",
    "./ground-shader": "./src/ground-shader/index.js",
    "./rockgen": "./src/rockgen/index.js",
    "./debrisgen": "./src/debrisgen/index.js",
    "./ambientfx": "./src/ambientfx/index.js",
    "./fauna": "./src/fauna/index.js",
    "./texgen": "./src/texgen/index.js",
    "./assetlib": "./src/assetlib/index.js",
    "./character": "./src/character/index.js",
    "./loaders": "./src/loaders/index.js",
    "./debug": "./src/debug/index.js",
    "./toon-settings": "./src/toon/toonSettings.js",
    "./water-settings": "./src/water/waterSettings.js",
    "./grass": "./src/vegetation/stylizedGrass.js",
    "./post-processing": "./src/post/postProcessing.js",
    "./agents/*": "./agents/*"
  },
  "scripts": {
    "assets:characters": "node scripts/generate-local-character-assets.mjs",
    "assets:environments": "node scripts/generate-local-environment-assets.mjs",
    "assets:plateau-landmarks": "node scripts/extract-plateau-landmarks.mjs",
    "assets:local": "npm run assets:characters && npm run assets:environments",
    "verify:scene-depth-pass": "node scripts/verify-scene-depth-color-pass.mjs",
    "dev": "vite",
    "mcp": "node mcp/server.mjs",
    "build": "vite build",
    "baseline:compare": "node scripts/compare-baselines.mjs",
    "preview": "vite preview",
    "baseline:capture": "node scripts/baseline-capture.mjs",
    "verify:rockgen": "node scripts/verify-rockgen.mjs",
    "verify:rock-shader": "node scripts/verify-rock-shader.mjs",
    "verify:ground-shader": "node scripts/verify-ground-shader.mjs",
    "verify:pathgen": "node scripts/verify-pathgen.mjs",
    "visual:check": "node scripts/visual-check.mjs",
    "verify:propgen": "node scripts/verify-propgen.mjs",
    "verify:buildinggen": "node scripts/verify-buildinggen.mjs",
    "verify:villagegen": "node scripts/verify-villagegen.mjs",
    "verify:fauna": "node scripts/verify-fauna.mjs",
    "verify:ambientfx": "node scripts/verify-ambientfx.mjs",
    "verify:vfxgen": "node scripts/verify-vfxgen.mjs",
    "verify:water": "node scripts/verify-watergen.mjs",
    "verify:landscape": "node scripts/verify-landscape.mjs",
    "verify:lighting": "node scripts/verify-lighting.mjs",
    "verify:lighting-lab": "node scripts/verify-lighting-lab.mjs",
    "verify:lab-roadmap": "node scripts/verify-lab-roadmap.mjs",
    "verify:lab-preview": "node scripts/verify-lab-preview.mjs",
    "verify:weather": "node scripts/verify-weather.mjs",
    "verify:climate": "node scripts/verify-climate.mjs",
    "verify:atmospheric-condition-lab": "node scripts/verify-atmospheric-condition-lab.mjs",
    "verify:sky": "node scripts/verify-sky.mjs",
    "verify:cloud-shader": "node scripts/verify-cloud-shader.mjs",
    "verify:environment-cycle": "node scripts/verify-environment-cycle.mjs",
    "verify:manufactured-materials": "node scripts/verify-manufactured-materials.mjs",
    "verify:ground-field": "node scripts/verify-ground-field.mjs",
    "verify:grass": "node scripts/verify-grass-palettes.mjs",
    "verify:vegetation-shader": "node scripts/verify-vegetation-shader.mjs",
    "verify:product-namespace": "node scripts/verify-product-namespace.mjs",
    "verify:api": "node scripts/verify-public-api.mjs",
    "verify:package": "node scripts/verify-package-boundary.mjs",
    "verify:generation": "node scripts/verify-generation.mjs",
    "verify:post": "node scripts/verify-post.mjs",
    "verify:camera": "node scripts/verify-camera.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "verify:biome": "node scripts/verify-biome.mjs",
    "verify:soundscape": "node scripts/verify-soundscape.mjs",
    "verify:game-feel": "node scripts/verify-game-feel.mjs",
    "verify:world-quality": "node scripts/verify-world-quality.mjs",
    "verify:all": "npm run verify:product-namespace && npm run verify:generation && npm run verify:post && npm run verify:camera && npm run verify:motion && npm run verify:biome && npm run verify:soundscape && npm run verify:game-feel && npm run verify:world-quality && npm run verify:rock-shader && npm run verify:ground-shader && npm run verify:rockgen && npm run verify:pathgen && npm run verify:propgen && npm run verify:buildinggen && npm run verify:villagegen && npm run verify:fauna && npm run verify:ambientfx && npm run verify:vfxgen && npm run verify:water && npm run verify:landscape && npm run verify:lighting && npm run verify:lighting-lab && npm run verify:lab-roadmap && npm run verify:lab-preview && npm run verify:weather && npm run verify:climate && npm run verify:atmospheric-condition-lab && npm run verify:sky && npm run verify:cloud-shader && npm run verify:environment-cycle && npm run verify:manufactured-materials && npm run verify:ground-field && npm run verify:grass && npm run verify:vegetation-shader && npm run verify:api && npm run verify:package && npm run verify:catalog && npm run verify:assetlib && npm run verify:mcp",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:assetlib": "node scripts/verify-assetlib.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "thumbs:prop": "node scripts/generate-prop-thumbs.mjs",
    "thumbs:building": "node scripts/generate-building-thumbs.mjs",
    "thumbs:catalog": "node scripts/generate-catalog-thumbs.mjs",
    "thumbs:home": "node scripts/generate-home-shots.mjs"
  },
  "peerDependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "3d-tiles-renderer": "^0.5.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.8.3",
    "three-stdlib": "^2.36.1"
  },
  "peerDependenciesMeta": {
    "@pixiv/three-vrm": {
      "optional": true
    },
    "3d-tiles-renderer": {
      "optional": true
    },
    "three-mesh-bvh": {
      "optional": true
    },
    "three-stdlib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "3d-tiles-renderer": "^0.5.0",
    "draco3d": "^1.5.7",
    "ecctrl": "^1.0.97",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.6",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.8.3",
    "three-stdlib": "^2.36.1",
    "vite": "^5.0.0"
  }
}
